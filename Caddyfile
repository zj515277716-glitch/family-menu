# family-menu Caddyfile
# 对齐实施方案第84行：Caddy(443, 备案后) / 直连IP(过渡期)
# 对齐实施方案第677行：Caddyfile已备好，备案通过改DNS+起caddy即可

# ── 过渡期：IP直连（Caddy 托管 H5 静态文件 + 反向代理 API） ──
# ECS 部署后直接访问 http://<ECS公网IP>:8080 即可使用
:80 {
	# API 反向代理
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health* {
		reverse_proxy api:3000
	}

	# H5 静态文件托管
	handle {
		root * /srv/h5
		# 缓存策略（2026-09-15 手机端遮挡"修了没生效"根因）：
		# index.html 无 Cache-Control 时，移动浏览器按 Last-Modified 启发式缓存（微信 webview 尤甚），
		# 部署后手机仍用旧 index.html → 引用旧 hash css → 新样式不生效。
		# 口径：默认 no-cache（每次回源校验，ETag 304 代价小）；带内容 hash 的 css/js 长缓存 immutable。
		# 注意：不用"无 matcher 的 header + 带 matcher 的 header"并存——实测二者应用顺序与源码顺序相反，
		# immutable 会被默认值覆盖；改用互斥 matcher 写法，无顺序依赖。
		@hashed path /css/* /js/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@not-hashed not path /css/* /js/*
		header @not-hashed Cache-Control "no-cache"
		file_server
		try_files {path} /index.html
	}
}

# ── 备案后：域名 + 自动 HTTPS ──
# 启用步骤：
#   1. 域名 ICP 备案通过
#   2. DNS A 记录指向 ECS 公网 IP
#   3. 注释上方 :80 块，取消下方注释并替换域名
#   4. 重启 Caddy：docker compose --profile prod restart caddy
#   5. Caddy 自动申请 Let's Encrypt 证书并启用 HTTPS(443)
#
