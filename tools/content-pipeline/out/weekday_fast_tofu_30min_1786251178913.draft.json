{
  "id": "draft-1786251178911",
  "name": "家常红烧豆腐",
  "mealRole": "MAIN",
  "cuisine": "家常",
  "flavorTags": [
    "咸香",
    "鲜美"
  ],
  "spicyLevel": 0,
  "splitFlavor": false,
  "activeMinutes": 14,
  "totalMinutes": 22,
  "equipment": [
    "wok"
  ],
  "steps": [
    {
      "order": 1,
      "text": "北豆腐冲洗干净，切成2cm见方的块；大蒜切末；小葱分成葱白和葱绿，分别切小粒备用"
    },
    {
      "order": 2,
      "text": "炒锅烧热，倒入食用油，放入豆腐块，中小火煎至两面金黄，盛出备用"
    },
    {
      "order": 3,
      "text": "锅中留少许底油，下蒜末和葱白爆香，加入生抽、老抽、白砂糖、80ml清水，搅拌均匀煮至沸腾"
    },
    {
      "order": 4,
      "text": "倒入煎好的豆腐块，转小火焖煮8分钟让豆腐入味",
      "parallel": true
    },
    {
      "order": 5,
      "text": "玉米淀粉加剩余20ml清水调成水淀粉，倒入锅中，转大火翻炒至汤汁浓稠，撒上葱绿碎即可出锅"
    }
  ],
