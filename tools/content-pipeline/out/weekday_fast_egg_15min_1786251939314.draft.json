  "totalMinutes": 14,
  "equipment": [
    "steamer"
  ],
  "steps": [
    {
      "order": 1,
      "text": "蒸锅中加入500ml清水，开大火加热"
    },
    {
      "order": 2,
      "text": "鸡蛋打入大碗中，加入2g食用盐，用筷子充分搅打至蛋清蛋黄完全融合"
    },
    {
      "order": 3,
      "text": "往蛋液中加入450ml 40℃左右的温水，搅拌均匀后用细筛网过滤2次，撇去表面浮沫；碗口覆盖一层保鲜膜，用牙签扎6个小孔透气"
    },
    {
      "order": 4,
      "text": "待蒸锅水沸腾后，将蛋液碗放入蒸屉，转中小火蒸10分钟",
      "parallel": true
    },
    {
      "order": 5,
      "text": "蒸好后取出，淋上生抽、香油，撒上切碎的香葱末即可"
    }
  ],
