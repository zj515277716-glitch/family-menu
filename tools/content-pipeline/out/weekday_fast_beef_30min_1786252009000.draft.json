{
  "id": "draft-1786252008999",
  "name": "杭椒牛柳",
  "mealRole": "MAIN",
  "cuisine": "家常",
  "flavorTags": [
    "咸香",
    "微辣"
  ],
  "spicyLevel": 1,
  "splitFlavor": false,
  "activeMinutes": 12,
  "totalMinutes": 25,
  "equipment": [
    "wok"
  ],
  "steps": [
    {
      "order": 1,
      "text": "牛里脊逆纹切成0.5cm粗的条，加入5ml料酒、5ml生抽、3g玉米淀粉、1g黑胡椒粉抓拌均匀"
    },
    {
      "order": 2,
      "text": "将牛肉静置腌制10分钟",
      "parallel": true
    },
    {
      "order": 3,
      "text": "杭椒洗净去蒂，切成2cm长的斜段；大蒜切成薄片"
    },
    {
      "order": 4,
      "text": "炒锅烧热，倒入20ml食用油，下蒜片爆香"
    },
    {
      "order": 5,
      "text": "放入牛肉条快速滑炒1分钟至表面变色，盛出备用"
    },
    {
      "order": 6,
      "text": "锅中留底油，放入杭椒段翻炒1分钟至断生"
    },
    {
      "order": 7,
      "text": "倒回牛肉条，加入10ml生抽、5ml老抽、2g食用盐、1g黑胡椒粉，大火翻炒30秒均匀即可出锅"
    }
  ],
