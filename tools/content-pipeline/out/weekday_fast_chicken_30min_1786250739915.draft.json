{
  "id": "draft-1786250739913",
  "name": "青椒炒鸡丁",
  "mealRole": "MAIN",
  "cuisine": "家常",
  "flavorTags": [
    "咸香",
    "清爽"
  ],
  "spicyLevel": 0,
  "splitFlavor": false,
  "activeMinutes": 13,
  "totalMinutes": 20,
  "equipment": [
    "wok"
  ],
  "steps": [
    {
      "order": 1,
      "text": "鸡胸肉洗净，切成1cm见方的鸡丁，加入10ml料酒、5g淀粉、5ml生抽抓匀"
    },
    {
      "order": 2,
      "text": "鸡丁静置腌制10分钟",
      "parallel": true
    },
    {
      "order": 3,
      "text": "青椒去蒂去籽，切成与鸡丁大小相近的丁；大蒜去皮切末"
    },
    {
      "order": 4,
      "text": "炒锅烧热，倒入20ml食用油，放入蒜末爆香"
    },
    {
      "order": 5,
      "text": "倒入腌制好的鸡丁，快速翻炒约2分钟至表面完全变色"
    },
    {
      "order": 6,
      "text": "加入青椒丁，持续翻炒2分钟至青椒断生"
    },
    {
      "order": 7,
      "text": "加入剩余10ml生抽、2g食用盐，翻炒均匀即可出锅"
    }
  ],
