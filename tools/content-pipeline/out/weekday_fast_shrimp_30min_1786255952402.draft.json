{
  "id": "draft-1786255952399",
  "name": "蒜香西兰花炒虾仁",
  "mealRole": "MAIN",
  "cuisine": "家常",
  "flavorTags": [
    "咸香",
    "清爽"
  ],
  "spicyLevel": 0,
  "splitFlavor": false,
  "activeMinutes": 10,
  "totalMinutes": 20,
  "equipment": [
    "wok"
  ],
  "steps": [
    {
      "order": 1,
      "text": "虾仁解冻后开背去虾线，洗净沥干，加入10ml料酒、3g玉米淀粉抓拌均匀"
    },
    {
      "order": 2,
      "text": "虾仁静置腌制10分钟",
      "parallel": true
    },
    {
      "order": 3,
      "text": "西兰花切小朵，洗净沥干；大蒜剁成蒜末"
    },
    {
      "order": 4,
      "text": "炒锅中加清水烧开，放入1g食用盐，倒入西兰花焯水1分钟，捞出沥干备用"
    },
    {
      "order": 5,
      "text": "热锅倒入20ml食用油，下蒜末爆香，放入虾仁翻炒至表面泛红变色"
    },
    {
      "order": 6,
      "text": "倒入西兰花，加入15ml生抽、1g食用盐，快速翻炒均匀即可出锅"
    }
  ],
