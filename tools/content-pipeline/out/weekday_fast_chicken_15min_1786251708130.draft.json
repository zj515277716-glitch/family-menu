  "name": "青椒炒鸡丁",
  "mealRole": "MAIN",
  "cuisine": "家常",
  "flavorTags": [
    "咸香",
    "清爽"
  ],
  "spicyLevel": 0,
  "splitFlavor": false,
  "activeMinutes": 8,
  "totalMinutes": 12,
  "equipment": [
    "wok"
  ],
  "steps": [
    {
      "order": 1,
      "text": "鸡胸肉洗净切成1cm见方的丁，青椒去蒂去籽切成丁，大蒜切末；将鸡丁与料酒、5ml生抽、玉米淀粉抓拌均匀"
    },
    {
      "order": 2,
      "text": "鸡丁静置腌制3分钟",
      "parallel": true
    },
    {
      "order": 3,
      "text": "热锅倒入食用油，下蒜末爆香"
    },
    {
      "order": 4,
      "text": "下鸡丁快速翻炒约2分钟至完全变色"
    },
    {
      "order": 5,
      "text": "加入青椒丁翻炒1分钟至断生"
    },
    {
      "order": 6,
      "text": "加入剩余10ml生抽、食用盐，翻炒均匀后出锅"
    }
  ],
